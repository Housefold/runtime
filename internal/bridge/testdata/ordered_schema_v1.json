{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Housefold synthetic ordered-state payload v1",
  "type": "object",
  "required": [
    "kind",
    "epoch",
    "sequence"
  ],
  "properties": {
    "kind": {
      "enum": [
        "snapshot_begin",
        "snapshot_chunk",
        "snapshot_end",
        "delta",
        "heartbeat"
      ]
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "entities": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "state",
          "attributes",
          "last_changed",
          "last_updated"
        ]
      }
    },
    "change": {
      "type": "object",
      "required": [
        "kind",
        "entity_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "add",
            "update",
            "remove"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "entity": {
          "type": "object"
        }
      }
    }
  }
}
